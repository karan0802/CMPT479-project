{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "vitest",
  "vitest": { "configFile": "vitest.generated.config.ts" },
  "checkers": ["typescript"],
  "tsconfigFile": "tsconfig.generated.json",
  "disableBail": true,
  "ignorePatterns": [".claude", ".github", "docs", "examples", "reports", ".stryker-tmp"],
  "reporters": ["json", "clear-text", "progress"],
  "jsonReporter": { "fileName": "reports/mutation/mutation.json" },
  "timeoutMS": 10000,
  "timeoutFactor": 2,
  "concurrency": 2,
  "tempDirName": ".stryker-tmp"
}
